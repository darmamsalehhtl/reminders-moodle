# Moodle server base URL, no trailing slash.
MOODLE_URL=https://edufs.edu.htl-leonding.ac.at/moodle

# Web service token. Mint one with:
#   node bin/moodle-tasks.js --login
# which POSTs your username/password to /login/token.php once and saves the
# resulting token here. It is NOT your account password - do not paste that
# here directly.
MOODLE_TOKEN=

# Your Moodle numeric user id. --login fills this in automatically via
# core_webservice_get_site_info; only set it by hand if you already know it.
MOODLE_USER_ID=

# Fallback source when the web service is unavailable or restricted:
# the "Calendar > Export calendar" URL from Moodle's UI
# (https://.../calendar/export_execute.php?userid=...&authtoken=...&preset_what=all&preset_time=recentupcoming).
# Only needed if you pass --source ical or the web service call fails.
MOODLE_ICAL_URL=
# Optional overrides (all have sane defaults, uncomment to change):
# SOON_DAYS=3
# LOOKAHEAD_DAYS=30
# REMINDERS_LIST=Schulaufgaben
# ALARM_LEAD_HOURS=24      # reminder alarm fires this many hours before the due date
# COURSE_PREFIX=1          # 1 = "[Course] Title" in Reminders, 0 = plain title
# IGNORE_COURSES=Sport,Religion     # comma-separated; matching courses are hidden and not synced
# IGNORE_TITLES=Anwesenheit         # comma-separated title substrings to hide
# DIGEST=1                 # 1 = one summary notification per sync run, 0 = off
# EVENTS=1                 # 1 = also sync your own Moodle calendar appointments, 0 = off
# REMINDERS_EVENTS_LIST=Schultermine   # Reminders list those appointments go into
# EVENT_ALARM_LEAD_HOURS=1 # appointment alarm fires this many hours before it starts
#                          # (an all-day appointment is alarmed at 08:00 on the day)
